# SyncVault server configuration.
# Copy this file to `.env` and Bun will load it by automatically

# The SQLite database file. Its directory is created if missing.
# DATABASE_FILE=data/syncvault.sqlite

# The port to listen on.
# PORT=3000

# The URL users reach the server at, if a reverse proxy changes it. Used for the
# OAuth issuer, the session cookie's Secure flag, and passkeys, which are bound
# to its hostname. Defaults to each request's own origin.
# PUBLIC_URL=https://sync.example.com

# Set to `true` behind a reverse proxy, so the sign-in rate limit takes the
# client's IP from the last X-Forwarded-For entry.
# TRUST_PROXY=false

# The token setup requires. If unset, a random one is printed at startup while
# setup is pending. Setting one keeps the setup link the same across restarts.
# SETUP_TOKEN=

# How long an app's access tokens last, in seconds.
# ACCESS_TOKEN_TTL=3600

# Milliseconds between pings on apps' event streams. At least 1000.
# PING_INTERVAL=15000

# The dashboard's build output. Defaults to packages/dashboard/build.
# DASHBOARD_DIR=
